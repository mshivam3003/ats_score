{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "ats_ui/ResumeRise-fullstack/ResumeRise/frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
