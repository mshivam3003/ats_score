# ResumeRise AI - Environment Variables Reference
# Copy to .env for local development. Configure these in the Vercel Project Dashboard (Settings > Environment Variables).
# NEVER commit your real .env file with secrets.

# AI / LLM Configuration (Google Gemini or OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenRouter (Alternative provider)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Authentication (JWT Secret for signing user login tokens)
JWT_SECRET=your_random_secure_jwt_secret_key_here

# Outbound SMTP Email (For OTP verification codes and Job alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# Job Scout Scraping Limits
JOB_DETAILS_MAX=4
JOB_DETAILS_TIMEOUT_S=10
